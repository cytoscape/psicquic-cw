{
  "//": [
    "App sources only. Build tooling (vite.config.ts) lives in",
    "tsconfig.node.json.",
    "",
    "The `types` list is what pulls in the ambient `cyweb/*` modules and",
    "`virtual:cyweb-app-meta` — do NOT set `typeRoots`, it suppresses the",
    "default lookup that finds these."
  ],
  "include": ["src/**/*"],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "noImplicitAny": true,
    "strictNullChecks": true,
    "isolatedModules": true,
    "noEmit": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "types": [
      "@cytoscape-web/api-types",
      "@cytoscape-web/app-runtime/meta",
      "vite/client"
    ]
  }
}
